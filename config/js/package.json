{
  "name": "sta-config",
  "version": "1.0.0",
  "description": "ST Annotator Configurations",
  "keywords": [
    "config",
    "configuration"
  ],
  "homepage": "https://github.com/DESRLab/st-annotator",
  "bugs": {
    "url": "https://github.com/DESRLab/st-annotator/issues"
  },
  "license": "Apache-2.0",
  "author": "DESRLab",
  "contributors": [
    "Cyrus Leung <tlleungac@connect.ust.hk>",
    "Maral Bahari <mbahari@connect.ust.hk>"
  ],
  "type": "module",
  "exports": {
    "./vite": "./lib/vite/index.js",
    "./eslint": "./eslint.config.mjs"
  },
  "scripts": {
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,mjs,cjs}\" --ignore-path ../../.prettierignore",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "node --test test/*.test.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@eslint/js": "^9.39.4",
    "autoprefixer": "^10.4.14",
    "eslint-plugin-chai-friendly": "^1.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "globals": "^17.6.0",
    "typescript-eslint": "^8.65.0"
  },
  "peerDependencies": {
    "@vitest/coverage-istanbul": "^1.4.0",
    "eslint": "^9.39.4",
    "jsdom": "^24.0.0",
    "rollup-plugin-sourcemaps": "^0.6.3",
    "typescript": "^5.7.2",
    "vite": "^5.2.6",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-externalize-deps": "^0.8.0",
    "vitest": "^1.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DESRLab/st-annotator"
  },
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  }
}
