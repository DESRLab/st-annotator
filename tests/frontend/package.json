{
  "name": "st-annotator-frontend-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,mjs,cjs}\" --ignore-path ../../.prettierignore --log-level silent",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,mjs,cjs}\" --ignore-path ../../.prettierignore",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.type-contracts.json",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test -c playwright.auth.config.ts",
    "test:e2e:with-data": "playwright test -c playwright.with-data.config.ts",
    "show-report:e2e": "playwright show-report playwright-report",
    "show-report:auth": "playwright show-report playwright-report-auth",
    "show-report:with-data": "playwright show-report playwright-report-with-data",
    "install:browsers": "playwright install"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^20",
    "sta": "^1.0.0",
    "sta-bbox": "^1.0.0",
    "sta-config": "^1.0.0",
    "sta-segmentation": "^1.0.0",
    "sta-vector": "^1.0.0",
    "zod": "^3.22.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
