{
  "name": "sta",
  "version": "5.0.0",
  "description": "ST Annotator Frontend",
  "keywords": [
    "computer-vision",
    "3d",
    "spatiotemporal",
    "spatio-temporal",
    "spatial-temporal",
    "annotation",
    "annotation-tool",
    "labeling",
    "labeling-tool"
  ],
  "homepage": "https://github.com/DESRLab/st-annotator",
