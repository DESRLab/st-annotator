{
  "extends": [
    "../../config/js/tsconfig.json",
    "./tsconfig.paths.json"
  ],
  "include": [
    ".react-router/types/**/*",
    "app",
    "client",
    "lib"
  ],
  "exclude": [
    "build",
    "node_modules",
    "test",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "compilerOptions": {
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [
      ".",
      "./.react-router/types"
    ],
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  }
}
