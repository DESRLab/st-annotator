    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "jsdom": "^24.0.0",
    "sta-config": "file:../../../config/js",
    "ts-essentials": "^9.3.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-css-injected-by-js": "^3.5.0",
    "vitest": "^1.4.0"
  },
  "directories": {
    "lib": "lib",
    "test": "test"
