{
  "name": "sta-vector",
  "version": "5.0.0",
  "description": "ST Annotator Vector Labels Plugin",
  "keywords": [
    "computer-vision",
    "3d",
    "spatiotemporal",
    "spatio-temporal",
    "spatial-temporal",
    "polygon",
    "polyline",
    "point",
    "annotation",
    "annotation-tool",
    "labeling",
    "labeling-tool"
  ],
  "homepage": "https://github.com/DESRLab/st-annotator",
