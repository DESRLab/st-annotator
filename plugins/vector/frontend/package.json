        "./dist/types/label/lib"
      ]
    }
  },
  "peerDependencies": {
    "@arcgis/core": "^4.27.6",
    "@slickgrid-universal/common": "^3.6.0",
    "dataclass": "^2.1.1",
    "jquery": "^3.6.0",
    "jstree": "^3.3.14",
    "lodash": "^4.17.21",
    "mathjs": "^9.4.1",
    "sta": "file:../../../frontend",
    "sta-gmesh": "file:../../gmesh/frontend",
    "sta-pcd": "file:../../pcd/frontend",
    "three": "^0.159.0",
    "ts-bidirectional-map": "^1.0.2",
    "tweakpane": "^3.1.10",
    "typescript-collections": "^1.3.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/chai": "^4.3.1",
    "@types/jquery": "^3.5.14",
    "@types/lodash": "^4.14.182",
    "@types/three": "^0.159.0",
    "@vitest/coverage-istanbul": "^1.4.0",
    "depcheck": "^1.4.7",
