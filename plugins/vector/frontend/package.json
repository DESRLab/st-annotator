{
  "name": "sta-vector",
  "version": "1.0.0",
  "description": "ST Annotator Vector Labels Plugin",
  "keywords": [
    "computer-vision",
    "3d",
    "spatiotemporal",
    "spatio-temporal",
    "spatial-temporal",
    "polygon",
    "polyline",
    "point",
    "annotation",
    "annotation-tool",
    "labeling",
    "labeling-tool"
  ],
  "homepage": "https://github.com/DESRLab/st-annotator",
  "bugs": {
    "url": "https://github.com/DESRLab/st-annotator/issues"
  },
  "license": "Apache-2.0",
  "author": "DESRLab",
  "contributors": [
    "Cyrus Leung <tlleungac@connect.ust.hk>",
    "Maral Bahari <mbahari@connect.ust.hk>"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./app": {
      "types": "./dist/app/index.d.ts",
      "import": "./dist/app/index.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "import": "./dist/models/index.js"
    }
  },
  "scripts": {
    "build:package": "node ../../../scripts/clean-frontend-dist.mjs . && tsc -p tsconfig.build.json && node ../../../scripts/copy-frontend-assets.mjs .",
    "prepack": "npm run build:package",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,mjs,cjs}\" --ignore-path ../../../.prettierignore --log-level silent",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,mjs,cjs}\" --ignore-path ../../../.prettierignore",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@arcgis/core": "^4.27.6",
    "sta-gmesh": "^1.0.0",
    "sta-pcd": "^1.0.0"
  },
  "peerDependencies": {
    "@slickgrid-universal/common": "^10.4.0",
    "jquery": "^3.6.0",
    "jstree": "^3.3.14",
    "lodash": "^4.17.21",
    "mathjs": "^9.4.1",
    "sta": "^1.0.0",
    "three": "^0.159.0",
    "ts-bidirectional-map": "^1.0.2",
    "typescript-collections": "^1.3.3",
    "zod": "^3.22.4",
    "react": "^19.0.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.0.0",
    "react-router": "^7.6.2",
    "slickgrid-react": "^10.4.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.1",
    "@types/jquery": "^3.5.14",
    "@types/lodash": "^4.14.182",
    "@types/three": "^0.159.0",
    "chai": "^4.3.6",
    "sta": "^1.0.0",
    "sta-config": "^1.0.0",
    "vitest": "1.6.1"
  },
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DESRLab/st-annotator"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
